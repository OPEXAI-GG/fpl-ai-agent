# Website settings. Copy to web/.env.local for the Next.js site; export the WEB_* values in the
# shell (or your process manager) for the Python API and worker. All have safe defaults.

# --- Next.js site (server-side only) --------------------------------------------------------
# Where the Python API listens; the site proxies /api/* to it.
API_URL=http://127.0.0.1:8000

# --- Python API and worker (fpl-agent web ...) ----------------------------------------------
# App state (SQLite), published data revisions, forecasts and the sample team.
WEB_DATA_DIR=data_cache/web
# The engine's working football database. Only `fpl-agent web publish` reads it, read-only.
WEB_SOURCE_DB=data_cache/football.duckdb
WEB_SEASON=2026
# Shared forecast: simulated worlds and gameweeks ahead.
WEB_SAMPLES=1000
WEB_HORIZON=8
# Worker processes started by scripts/web_demo.sh (1-4).
WEB_WORKERS=2
# Queued plans before new requests are refused, and per-visitor limits.
WEB_MAX_QUEUE=20
WEB_PLANS_PER_HOUR=12
WEB_LOOKUPS_PER_MINUTE=20
# Seconds a plan may run before it stops and is shown as preliminary (timed out).
WEB_PLAN_BUDGET_S=900
