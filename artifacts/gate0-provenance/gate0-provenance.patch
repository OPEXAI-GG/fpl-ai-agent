+    def delete(self, table: str, where: str, params: list, reason: str) -> int:
+        n = self._keep(table, "removed", f"SELECT * FROM {table} WHERE {where}", params, reason)
+        if n:
+            self.db.con.execute(f"DELETE FROM {table} WHERE {where}", params)
+        return n
