diff --git a/scripts/data_publish.sh b/scripts/data_publish.sh
index 76c2b1b..79948c8 100755
--- a/scripts/data_publish.sh
+++ b/scripts/data_publish.sh
@@ -4,21 +4,47 @@
 # (football-db-<stamp>.tar.zst) so an earlier database can be restored (DATA_ASSET=...).
 # Dated copies are never deleted here; the run lists any beyond KEEP_ARCHIVES (default 10) so
 # they can be pruned by hand. GH and VERIFY can be overridden (tests use stand-ins).
+# Order, so a failure never replaces the asset readers use: verify the folder (every declared
+# table, manifest intact), build the archive, unpack that archive and verify it again, check its
+# size, upload the dated copy and confirm the release lists it, and only then replace
+# football-db.tar.zst. MAX_ARCHIVE_BYTES (default 1.9 GB, under GitHub's 2 GiB asset limit)
+# bounds what one publish may upload.
 set -euo pipefail
+# verified only on Linux with zstd (CI's shell tests); anywhere else refuse before touching the
+# release, rather than run an archive path nobody has tested there
+if [ "$(uname -s)" != Linux ] || ! command -v zstd >/dev/null 2>&1; then
+  echo "unsupported environment ($(uname -s), zstd: $(command -v zstd || echo missing)): this script is verified only on Linux with zstd" >&2
+  exit 2
+fi
 dir="${1:-data_cache/export}"
 GH="${GH:-gh}"
 VERIFY="${VERIFY:-uv run fpl-agent verify-export}"
 keep="${KEEP_ARCHIVES:-10}"
+max_bytes="${MAX_ARCHIVE_BYTES:-1900000000}"
 
-$VERIFY "$dir"
+$VERIFY --complete "$dir"
 tmp="$(mktemp -d)"
 trap 'rm -rf "$tmp"' EXIT
 stamp="$(date -u +%Y%m%dT%H%M%SZ)"
 tar --zstd -cf "$tmp/football-db.tar.zst" -C "$dir" .
+# what is uploaded is what was checked: the archive itself is unpacked and verified
+mkdir "$tmp/check"
+tar --zstd -xf "$tmp/football-db.tar.zst" -C "$tmp/check"
+$VERIFY --complete "$tmp/check"
+size="$(stat -c %s "$tmp/football-db.tar.zst")"
+if [ "$size" -gt "$max_bytes" ]; then
+  echo "archive is $size bytes, over MAX_ARCHIVE_BYTES=$max_bytes: nothing published" >&2
+  exit 1
+fi
 cp "$tmp/football-db.tar.zst" "$tmp/football-db-$stamp.tar.zst"
 $GH release view data >/dev/null 2>&1 || $GH release create data --title "football database" \
   --notes "Latest export of the football database (parquet + manifest), with dated copies."
+# no --clobber: an existing dated copy is never overwritten (the upload fails instead)
 $GH release upload data "$tmp/football-db-$stamp.tar.zst"
+if ! $GH release view data --json assets --jq '.assets[].name' | grep -qxF "football-db-$stamp.tar.zst"; then
+  echo "dated copy football-db-$stamp.tar.zst is not on the release: football-db.tar.zst left unchanged" >&2
+  exit 1
+fi
 $GH release upload data "$tmp/football-db.tar.zst" --clobber
 echo "published football-db.tar.zst and football-db-$stamp.tar.zst"
 old="$($GH release view data --json assets --jq '.assets[].name' | grep '^football-db-' | sort | head -n -"$keep" || true)"
diff --git a/scripts/data_restore.sh b/scripts/data_restore.sh
index 6046764..63464fd 100755
--- a/scripts/data_restore.sh
+++ b/scripts/data_restore.sh
@@ -5,18 +5,34 @@
 # restore can never be mistaken for an empty database and published over the good one.
 # DATA_ASSET picks an older dated archive (football-db-<stamp>.tar.zst) to roll back to.
 # GH and VERIFY can be overridden (tests use stand-ins).
+# The archive may hold only manifest.json and <table>.parquet files at its top level (no
+# links, folders or paths); it is checked before unpacking. A legacy archive without a
+# manifest is accepted if it holds at least one table. Files reach $1 only complete: they are
+# assembled in a sibling folder that is renamed into place.
 set -euo pipefail
+# verified only on Linux with zstd (CI's shell tests); anywhere else refuse before touching the
+# release, rather than run an archive path nobody has tested there
+if [ "$(uname -s)" != Linux ] || ! command -v zstd >/dev/null 2>&1; then
+  echo "unsupported environment ($(uname -s), zstd: $(command -v zstd || echo missing)): this script is verified only on Linux with zstd" >&2
+  exit 2
+fi
 dir="${1:-data_cache/export}"
 asset="${DATA_ASSET:-football-db.tar.zst}"
 GH="${GH:-gh}"
 VERIFY="${VERIFY:-uv run fpl-agent verify-export}"
 
+# the name is also a download pattern: only the rolling asset or a dated copy
+if ! [[ "$asset" =~ ^football-db(-[0-9]{8}T[0-9]{6}Z)?\.tar\.zst$ ]]; then
+  echo "DATA_ASSET must be football-db.tar.zst or football-db-<YYYYMMDDTHHMMSSZ>.tar.zst" >&2
+  exit 1
+fi
 if [ -d "$dir" ] && [ -n "$(ls -A "$dir")" ]; then
   echo "refusing to restore into non-empty $dir" >&2
   exit 1
 fi
 tmp="$(mktemp -d)"
-trap 'rm -rf "$tmp"' EXIT
+stage=""
+trap 'rm -rf "$tmp"; [ -z "$stage" ] || rm -rf "$stage"' EXIT
 
 if ! assets="$($GH release view data --json assets --jq '.assets[].name' 2>"$tmp/err")"; then
   if grep -qi "release not found" "$tmp/err"; then
@@ -36,13 +52,29 @@ if ! grep -qxF "$asset" <<<"$assets"; then
 fi
 
 $GH release download data --pattern "$asset" --dir "$tmp"
+tar --zstd -tvf "$tmp/$asset" >"$tmp/list"
+while read -r mode _ _ _ _ name; do
+  case "$mode" in
+    d*) [ "$name" = "./" ] || [ "$name" = "." ] && continue ;;
+    -*) [[ "$name" =~ ^(\./)?(manifest\.json|[a-z0-9_]+\.parquet)$ ]] && continue ;;
+  esac
+  echo "archive member not allowed: $mode $name" >&2
+  exit 1
+done <"$tmp/list"
 mkdir "$tmp/x"
 tar --zstd -xf "$tmp/$asset" -C "$tmp/x"
 if [ -f "$tmp/x/manifest.json" ]; then
   $VERIFY "$tmp/x"
-else
+elif ls "$tmp/x" | grep -q '\.parquet$'; then
   echo "legacy export without a manifest: accepted (the next publish adds one)"
+else
+  echo "archive holds no tables" >&2
+  exit 1
 fi
-mkdir -p "$dir"
-cp -R "$tmp/x/." "$dir/"
+mkdir -p "$(dirname "$dir")"
+stage="$(mktemp -d "$(dirname "$dir")/.restore-XXXXXX")"
+cp -R "$tmp/x/." "$stage/"
+[ ! -d "$dir" ] || rmdir "$dir"
+mv "$stage" "$dir"
+stage=""
 echo "restored $(ls "$dir" | grep -c '\.parquet$') tables into $dir from $asset"
