SRC="$(wslpath -w "$G3/src51/src")"
exec /mnt/c/Users/bedor/OneDrive/Documents/FPL/fpl-ai-agent-1/.venv/Scripts/python.exe -I -c "import sys; sys.path.insert(0, sys.argv[1]); from fpl_agent.cli import main; sys.exit(main(['verify-export'] + sys.argv[2:]))" "$SRC" "${args[@]}"
